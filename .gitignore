__pycache__/
*.pyc

# Environments
venv/
.env/
.conda/

# macOS
.DS_Store

# Data — the dataset, the FAISS index and the intermediate jsonl stay out
# (too large, and all regenerable from steps 1-3). Evaluation results do NOT:
# they are the experimental record and the whole point of the comparison table.
# Note the trailing /* — with `data/processed/` git never descends into the
# directory, so the negation below would be ignored.
data/raw/
data/processed/*
!data/processed/eval_*.json

# Jupyter
.ipynb_checkpoints/

# Logs
*.log
